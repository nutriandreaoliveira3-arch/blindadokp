  "structures": [
    {
      "id": "nao-e-so",
      "regex": "(?i)\\bnão (?:é|se trata) (?:só|apenas|somente) (?:sobre |de )?[^.!?\\n]{2,60}[,.;]\\s*(?:é|mas)\\b",
      "name": "\"Não é só X, é Y\"",
      "fix": "Diga só o que você quer dizer. Corte a primeira metade."
    },
    {
      "id": "nao-apenas",
      "regex": "(?i)\\bnão (?:só|apenas|somente)\\b[^.!?\\n]{2,80}\\bmas (?:também|sim)\\b",
      "name": "\"Não apenas X, mas também Y\"",
      "fix": "Quebre em duas frases ou corte a parte mais fraca."
    },
    {
      "id": "nao-e-sobre",
      "regex": "(?i)\\bnão é sobre [^.!?\\n]{2,60}[.!,]\\s*é sobre\\b",
      "name": "\"Não é sobre X. É sobre Y.\"",
      "fix": "Comece pelo Y. A inversão é o que entrega a IA."
    },
    {
      "id": "nao-e-x-e-y",
      "regex": "(?i)\\bnão é [^.!?\\n]{2,40}\\.\\s*é [^.!?\\n]{2,60}[.!]",
      "name": "\"Não é X. É Y.\"",
      "fix": "Diga direto o Y. A negação antes é o ritmo padrão da IA."
    },
    {
      "id": "pergunta-revelacao",
      "regex": "(?im)^\\s*(?:o resultado|a melhor parte|o segredo|o detalhe|a pegadinha|o problema|sabe o que aconteceu)\\?\\s*$",
      "name": "Pergunta retórica sozinha na linha",
      "fix": "Responda direto, sem fazer suspense."
    },
    {
      "id": "o-que-aprendi",
      "regex": "(?i)\\b(?:aqui está|veja|isso é) o que (?:eu )?aprendi\\b|\\bo que (?:eu )?aprendi\\s*:",
      "name": "\"Aqui está o que aprendi\"",
      "fix": "Diga a lição. Pule o anúncio."
    },
    {
      "id": "triade",
      "regex": "(?i)\\b\\w+, \\w+ e \\w+\\.",
      "name": "Tríade (regra de três)",
      "fix": "Use dois itens ou quatro. Três é o ritmo padrão da IA."
    },
    {
      "id": "ja-parou",
      "regex": "(?i)\\bvocê já parou (?:para|pra) pensar\\b",
      "name": "\"Você já parou para pensar...\"",
      "fix": "Vá direto para a ideia."
    },
    {
      "id": "mundo-cada-vez",
      "regex": "(?i)\\bem um mundo cada vez mais\\b",
      "name": "\"Em um mundo cada vez mais...\"",
      "fix": "Abertura genérica. Comece por um fato seu."
    },
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1✨\\U0001F3AF]",
      "name": "Emoji de foguete / fogo / lâmpada / brilho / alvo",
      "fix": "No máximo um emoji, e não um desses cinco."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Muro de hashtags (5+)",
      "fix": "Três hashtags no máximo."
    },
    {
      "id": "como-ia",
      "regex": "(?i)\\bcomo (?:uma|um) (?:ia|inteligência artificial|modelo de linguagem)\\b",
      "name": "Autorreferência de IA",
      "fix": "Apague a frase."
    },
    {
      "id": "em-resumo",
      "regex": "(?im)^\\s*(?:em resumo|resumindo|em suma|para concluir|concluindo)\\b",
      "name": "Abertura de conclusão de redação",
      "fix": "Post não precisa de parágrafo de conclusão."
    },
    {
